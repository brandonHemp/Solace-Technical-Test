{
  "name": "solace-candidate-assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx ./src/db/seed/seed.ts",
    "db:seed:large": "tsx ./src/db/seed/advocatesLarge.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:docker-setup": "docker-compose up -d && timeout 10 && npm run db:setup",
    "db:whole:enchilada": "docker-compose up -d && timeout 10 && npm run generate && npm run migrate && npm run db:seed",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:start": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "clean": "powershell -Command \"if (Test-Path '.next') { Remove-Item -Path '.next' -Recurse -Force } ; if (Test-Path 'node_modules/.cache') { Remove-Item -Path 'node_modules/.cache' -Recurse -Force }\"",
    "dev:safe": "cross-env NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=512' next dev",
    "dev:memory": "powershell -Command \"$env:NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=512'; next dev\""
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.26.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.32.1",
    "next": "^15.3.3",
    "pg": "^8.16.3",
    "postgres": "^3.4.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.23.0",
    "esbuild-register": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.7.1",
    "typescript": "^5.5.4"
  }
}
